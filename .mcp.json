{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}"
      },
      "tools": ["*"]
    },
    "sanity": {
      "type": "http",
      "url": "https://mcp.sanity.io",
      "tools": ["*"]
    },
    "next-devtools": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "tools": ["*"]
    }
  }
}
