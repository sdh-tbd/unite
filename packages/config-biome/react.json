{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "nursery": {
        "useReactFunctionComponentDefinition": {
          "level": "error",
          "options": {
            "namedComponents": "functionDeclaration"
          }
        }
      }
    }
  }
}
